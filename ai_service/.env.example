# Copy to .env (never commit .env).
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order; the next one is used when a model is overloaded.
GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest
# Shared secret; must equal AiService__ApiKey in backend/.env.
AI_SERVICE_KEY=
# The ASP.NET backend (tools call its internal API).
BACKEND_URL=http://localhost:5252
# low = faster; "default" lets the model decide.
GEMINI_THINKING_LEVEL=low
